# 1Password-backed development environment. Contains REFERENCES, not secrets,
# so this file is committed. Run the app through `op run` to expand them:
#
#   pnpm dev:op          # = op run --env-file=.env.1password -- next dev
#
# Requires 1Password CLI 2.x, unlocked (desktop-app integration or `op signin`).
# Values here are injected into the shell environment, and Next.js does NOT let
# .env.local override an already-set shell variable (see @next/env processEnv),
# so this reference wins over any stale key sitting in .env.local.
TYPESAFE_API_KEY="op://Development/Jev API Key/password"

# Optional: override the Jev model id (defaults to jev-latest).
# JEV_MODEL=jev-latest

# Clean-room cost estimates: USD per million tokens. Blank means unknown.
CLEAN_ROOM_JEV_INPUT_RATE=0.042
CLEAN_ROOM_JEV_OUTPUT_RATE=
