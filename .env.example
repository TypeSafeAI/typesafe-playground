# Server-only: never prefix this variable with NEXT_PUBLIC_.
# Copy this file to .env.local and insert your own TypeSafe API key.
TYPESAFE_API_KEY=

# Clean-room generation is local and deterministic; Jev is the only model.
# Clean-room cost estimates: USD per million tokens. Blank means unknown.
CLEAN_ROOM_JEV_INPUT_RATE=0.042
CLEAN_ROOM_JEV_OUTPUT_RATE=
